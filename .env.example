# Proveedor del modelo: anthropic | openai
LLM_PROVIDER=anthropic
# Solo una de las dos, según el proveedor (nunca la subas al repositorio)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Modelo (opcional). Default: claude-sonnet-4-5 (anthropic) / gpt-4.1-mini (openai)
LLM_MODEL=
# Límites de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=300000
LLM_TIMEOUT_MS=60000
PORT=3000

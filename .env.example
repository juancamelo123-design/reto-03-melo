# Proveedor del modelo: anthropic | openai | gemini (gemini tiene capa gratuita en aistudio.google.com)
LLM_PROVIDER=anthropic
# Solo una de las dos, según el proveedor (nunca la subas al repositorio)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Modelo (opcional). Default: claude-sonnet-5-5 (anthropic) / gpt-4.1-mini (openai) / gemini-3.8-flash (gemini)
LLM_MODEL=
# Límites de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=300000
LLM_TIMEOUT_MS=60000
PORT=3000
